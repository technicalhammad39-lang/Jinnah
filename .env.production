# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ==========================================
# This file IS committed to Git and deployed to Hostinger.
# It provides NEXT_PUBLIC_* values that are inlined at BUILD TIME.
#
# ⚠️  NEVER put raw secrets here (private keys, admin credentials).
# ⚠️  Firebase Admin SDK vars must be set via Hostinger hPanel
#     Environment Variables, or via .env.production.local on the server.
# ==========================================

# 1. General Application Settings
NODE_ENV=production

# 2. Public Firebase Configuration (Client-side)
# These are safe to commit and are embedded in the production bundle.
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyC..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="jinnah-hardware-store.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="jinnah-hardware-store"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="jinnah-hardware-store.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="728282361138"
NEXT_PUBLIC_FIREBASE_APP_ID="1:728282361138:web:715d2a632e2c544e78a2dd"

# 3. Upload Configuration (Hostinger specifics)
# This MUST point to the actual path where uploaded images are saved on the server.
HOSTINGER_UPLOAD_ROOT="/home/u882372263/domains/jinnah-hardwarestore.com/node/uploads"
NEXT_PUBLIC_UPLOAD_BASE_URL="https://jinnah-hardwarestore.com/uploads"

# ==========================================
# SERVER-ONLY SECRETS (Required on Hostinger hPanel)
# ==========================================
# DO NOT add values for these variables here. They must be configured in Hostinger.

# 1. FIREBASE_PROJECT_ID
# Value: jinnah-hardware-store

# 2. FIREBASE_CLIENT_EMAIL
# Value: firebase-adminsdk-fbsvc@jinnah-hardware-store.iam.gserviceaccount.com

# 3. FIREBASE_PRIVATE_KEY_BASE64
# This is required for Firebase Admin.
# DO NOT put the raw multiline key here. Use the base64 encoded version.
# To generate it, save your key to a file and run: node scripts/encode-key.js
# Example: FIREBASE_PRIVATE_KEY_BASE64="LS0tLS1CRUdJTiBQUklWQ..."

# 4. VAPID_PRIVATE_KEY
# This is required for Push Notifications.
# Example: VAPID_PRIVATE_KEY="4wzwebij6..."

# 5. NEXT_PUBLIC_VAPID_PUBLIC_KEY
# Even though it has NEXT_PUBLIC, you can set it securely in Hostinger so it's injected during `npm run build`.
